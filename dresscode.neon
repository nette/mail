use:
	- nette
	- modernizations

typeAnalysis: phpstan

paths:
	- src
	- tests

fileExtensions:
	- php
	- phpt

imports: {grouping: {class: grouped}}

overrides:
	-
		paths: [src]
		nameResolution: certain
		use:
			- compilerOptimizations
			- deprecations

	- # constants published in upper case, where the case is part of the API
		paths: [src/Mail/MimePart.php]
		naming: {constant: keep}

	- # token types are named after the T_ constants of PHP's tokenizer
		paths: [src/Mail/CssInliner.php]
		naming: {constant: keep}

	- # the test mirrors the token constants of CssInliner
		paths: [tests/Mail/CssInliner.tokenizer.phpt]
		naming: {variable: keep}
